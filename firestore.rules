rules_version = '2';

// Strasbourg Mission — Firestore Security Rules
//
// Philosophy: deny everything by default, whitelist only expected patterns.
// These are conservative starter rules. See TODOs for production hardening.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default ──────────────────────────────────────────────────────────────
    // Deny all access not matched by a rule below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── stations/{stationId} ─────────────────────────────────────────────────
    // Mission config. Seeded by admin before the event. Never written by clients.
    match /stations/{stationId} {
      allow read: if true;
      allow write: if false;
    }

    // ── teams/{teamCode} ─────────────────────────────────────────────────────
    // Team registry. Created by admin. Clients read to validate team codes.
    // The team code itself acts as a shared secret — keep codes short but non-guessable.
    match /teams/{teamCode} {
      allow read: if true;
      allow write: if false;
    }

    // ── progress/{teamId} ────────────────────────────────────────────────────
    // One document per team. Tracks station completion and final answer.
    //
    // ⚠️  WARNING: These rules permit any client to read and write any progress
    // document because the app does not yet use Firebase Auth. A malicious user
    // could read other teams' progress or submit a fabricated completion.
    //
    // TODO (before production):
    //   1. Enable Firebase Anonymous Auth in the project.
    //   2. Sign in users anonymously when they enter their team code.
    //   3. Store the Firebase UID in the team document at login time.
    //   4. Replace `if true` below with:
    //        allow read, write: if request.auth != null
    //                           && request.auth.uid == resource.data.teamId;
    match /progress/{teamId} {
      allow read: if true;

      allow write: if true
        // Basic shape validation — at minimum the document must declare its teamId.
        && request.resource.data.keys().hasAll(["teamId"])
        && request.resource.data.teamId is string;
    }

    // ── settings/{docId} ─────────────────────────────────────────────────────
    // Global mission settings (settings/mission): shared countdown + announcement.
    // Mission Control (admin) writes; every device reads. Same open trust model
    // as progress above (no Firebase Auth yet) — see the progress warning.
    match /settings/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── quiz/{docId} ─────────────────────────────────────────────────────────
    // Live quiz state (quiz/state). Single writer in practice: Mission Control.
    match /quiz/{docId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── quizScores/{teamId} ──────────────────────────────────────────────────
    // Cumulative scores. Written by the admin controller; read by all devices.
    match /quizScores/{teamId} {
      allow read:  if true;
      allow write: if true;
    }

    // ── quizResponses/{runQuestion}/teams/{teamId} ───────────────────────────
    // One answer per team per question. CREATE-ONLY → an answer can never be
    // changed or deleted, which enforces "answer only once" server-side.
    //
    // Anti-cheat within the no-auth model:
    //   - submittedAt must equal the server time (request.time) → clients cannot
    //     forge a faster response time.
    //   - sessionId must match the team's active session marker on its progress
    //     doc (tolerant when none is set yet) → ties an answer to the logged-in
    //     device.
    function activeSessionId(teamId) {
      return get(/databases/$(database)/documents/progress/$(teamId)).data.get("sessionId", "");
    }
    match /quizResponses/{runQuestion}/teams/{teamId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(["teamId", "optionIndex", "submittedAt", "sessionId"])
        && request.resource.data.teamId == teamId
        && request.resource.data.optionIndex is int
        && request.resource.data.optionIndex >= 0
        && request.resource.data.optionIndex <= 3
        && request.resource.data.submittedAt == request.time
        && (
          activeSessionId(teamId) == ""
          || activeSessionId(teamId) == request.resource.data.sessionId
        );
      allow update, delete: if false;
    }

  }
}
